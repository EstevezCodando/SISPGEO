# ════════════════════════════════════════════════════════════════
#  SisPGeo — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA comite o arquivo .env no repositório.
# ════════════════════════════════════════════════════════════════

# ── Banco de dados ────────────────────────────────────────────────
DB_PASSWORD=Dsg2cgeo@

# ── JWT ───────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
SECRET_KEY=ce665896a0986ee0a3533635481ef0412709a8b1431d51d97759e9692d722dc7
ADMIN_PASSWORD=Dsg2cgeo@

#criacao de usuarios mock
# docker exec -e ADMIN_PASSWORD="Senha" sispgeo_backend python scripts/create_hierarchy_users.py

# ── Admin inicial ─────────────────────────────────────────────────
# Senha do usuário admin@eb.mil.br criado na primeira inicialização.
# Deve ter maiúscula, minúscula, número e caractere especial (mín. 8 chars).
ADMIN_PASSWORD=Dsg2cgeo@

# ── Ambiente ──────────────────────────────────────────────────────
# development | production
ENV=development

# CRÍTICO: manter false em produção.
# true = cria usuários de teste com senhas conhecidas na inicialização.
BDGEX_MOCK=false

# ── BDGEx ─────────────────────────────────────────────────────────
BDGEX_API_URL=http://bdgex.eb.mil.br/api

# ── URL pública do sistema (usada em links de e-mail) ─────────────
FRONTEND_URL=http://localhost

# ── E-mail: Resend (opcional — prioridade sobre SMTP) ─────────────
# Deixe vazio para usar SMTP.
RESEND_API_KEY=
RESEND_FROM=noreply@seudominio.com.br

# ── E-mail: SMTP — Zimbra institucional (produção) ─────────────────
# Quando SMTP_USER e SMTP_PASSWORD estiverem preenchidos, o Zimbra é usado.
# Sem credenciais em ENV=development, o Mailpit captura os e-mails.
SMTP_HOST=smtp.webmail.eb.mil.br
SMTP_PORT=587
SMTP_TLS=false
SMTP_FROM=sispgeo@sispgeo.br
SMTP_USER=
SMTP_PASSWORD=

# ── Mailpit (dev) — captura e-mails em http://localhost:8025 ───────
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
MAILPIT_USER=admin
MAILPIT_PASS=troque_em_producao

# ── JWT expiry (padrão 480 min = 8h) ──────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480

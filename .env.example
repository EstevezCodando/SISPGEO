# Banco de dados
DB_PASSWORD=coter_secret

# JWT - gere com: openssl rand -hex 32
SECRET_KEY=changeme_super_secret_key_minimum_32_chars_here

# BDGEx
BDGEX_API_URL=http://bdgex.eb.mil.br/api
# true = usa dados simulados (sem acesso ao BDGEx real)
BDGEX_MOCK=true

# URL pública do sistema (usada em links de email)
FRONTEND_URL=http://localhost

# development | production
ENV=development

# ── E-mail Resend (produção recomendada) ───────────────────────────────────────
# Crie uma conta em https://resend.com e adicione um domínio verificado.
# Se RESEND_API_KEY estiver preenchido, o sistema usa Resend como primário
# e SMTP apenas como fallback.
RESEND_API_KEY=
RESEND_FROM=noreply@seudominio.com.br

# ── E-mail SMTP ────────────────────────────────────────────────────────────────
# Desenvolvimento: deixe como está (Mailpit captura em http://localhost:8025)
# Produção com Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=false          # STARTTLS é ativado automaticamente para porta 587
#   SMTP_FROM=seuemail@gmail.com
#   SMTP_USER=seuemail@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx   # Senha de App do Google (não a senha normal)
#
# Produção com servidor EB institucional:
#   SMTP_HOST=smtp.eb.mil.br            # confirme com o administrador de rede
#   SMTP_PORT=587
#   SMTP_TLS=false
#   SMTP_FROM=sisgeo@eb.mil.br
#   SMTP_USER=sisgeo@eb.mil.br
#   SMTP_PASSWORD=senha_institucional
#
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
SMTP_FROM=noreply@eb.mil.br
SMTP_USER=
SMTP_PASSWORD=

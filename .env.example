# Banco de dados
DB_PASSWORD=coter_secret

# JWT - gere com: openssl rand -hex 32
SECRET_KEY=changeme_super_secret_key_minimum_32_chars_here

# BDGEx
BDGEX_API_URL=http://bdgex.eb.mil.br/api
# true = usa dados simulados (sem acesso ao BDGEx real)
BDGEX_MOCK=true

# URL pública do sistema (usada em links de email)
FRONTEND_URL=http://localhost

# development | production
ENV=development

# ── E-mail Resend (opcional — prioridade sobre SMTP quando definido) ───────────
# Crie uma conta em https://resend.com e adicione um domínio verificado.
# Deixe vazio para usar SMTP (Zimbra em produção, Mailpit em dev).
RESEND_API_KEY=
RESEND_FROM=noreply@seudominio.com.br

# ── E-mail SMTP — Zimbra institucional (produção) ──────────────────────────────
# Quando ENV=development, os e-mails são redirecionados para o Mailpit
# independente das variáveis abaixo.
#
# Zimbra (EB):
#   SMTP_HOST=smtp.webmail.eb.mil.br
#   SMTP_PORT=587
#   SMTP_TLS=false          # STARTTLS ativado automaticamente na porta 587
#   SMTP_FROM=sispgeo@sispgeo.br
#   SMTP_USER=sispgeo@sispgeo.br
#   SMTP_PASSWORD=senha_zimbra
#
# Gmail (homologação):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=false
#   SMTP_FROM=seuemail@gmail.com
#   SMTP_USER=seuemail@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx   # Senha de App (não a senha normal)
#
SMTP_HOST=smtp.webmail.eb.mil.br
SMTP_PORT=587
SMTP_TLS=false
SMTP_FROM=sispgeo@sispgeo.br
SMTP_USER=sispgeo@sispgeo.br
SMTP_PASSWORD=senha_zimbra

# ── Mailpit (dev) — captura e-mails em http://localhost:8025 ───────────────────
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
